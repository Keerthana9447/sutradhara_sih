# Groq API configuration for the optional answer-paraphrase layer (app/llm.py).
# The system works correctly with this left blank — the grounded,
# template-assembled answer is used as-is (llm_paraphrased=false in the
# API response). Setting these only adds a readability pass on top; it can
# never add uncited legal claims (see app/llm.py for the safety check).
GROQ_API_KEY=""
GROQ_MODEL=openai/gpt-oss-120b

# Set to "false" to force-disable the paraphrase layer even if a key is set.
ENABLE_LLM_PARAPHRASE=true

# Per-request timeout (seconds) for the Groq call before falling back.
GROQ_TIMEOUT_SECONDS=12

# --------------------------------------------------------------------------
# Bhashini (ULCA / MeitY Digital India language infrastructure)
# --------------------------------------------------------------------------
# Single shared Bhashini credentials — covers NMT, ASR, and TTS.
# Bhashini is the PRIMARY provider for all three services.
# If Bhashini fails, Sarvam is the FALLBACK provider.
#
# Provider chain:
#   NMT: Bhashini → Sarvam → Google Translate → MyMemory
#   ASR: Bhashini → Sarvam
#   TTS: Bhashini → Sarvam
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""

# --------------------------------------------------------------------------
# Sarvam AI — FALLBACK provider for NMT, ASR, and TTS
# --------------------------------------------------------------------------
# Single key covering speech-to-text (Saaras v3), text-to-speech (Bulbul v3),
# and translation (sarvam-translate:v1).
SARVAM_API_KEY=""

# --------------------------------------------------------------------------
# Corpus freshness thresholds (app/corpus_freshness.py)
# --------------------------------------------------------------------------
# Days since a corpus entry's retrieved_date before it's bucketed "aging"/
# "stale". Both optional — sensible defaults are built in.
# SUTRADHARA_FRESH_DAYS=90
# SUTRADHARA_STALE_DAYS=180

# --------------------------------------------------------------------------
# Data retention (app/privacy.py — DPDP-aligned governance)
# --------------------------------------------------------------------------
# How long audit/feedback/escalation rows are kept before POST
# /api/privacy/purge-expired hard-deletes them. Optional.
# SUTRADHARA_RETENTION_DAYS=180

# --------------------------------------------------------------------------
# Live International patent lookups (app/registry_lookup.py)
# --------------------------------------------------------------------------
# Free key: https://patentsview.org/apis/keyrequest
# Leave blank to keep POST /api/registry/lookup honestly returning
# live=False for International queries.
PATENTSVIEW_API_KEY=""

# --------------------------------------------------------------------------
# Optional live Neo4j knowledge-graph backend (app/graph_store.py)
# --------------------------------------------------------------------------
# All three must be set for the live backend to activate; otherwise
# app/graph_reasoning.py's in-memory traversal runs unchanged.
NEO4J_URI=""
NEO4J_USER=""
NEO4J_PASSWORD=""
# Set to "1" to force the in-memory graph even if the above are configured.
# SUTRADHARA_DISABLE_NEO4J=1