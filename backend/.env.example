# Groq API configuration for the optional answer-paraphrase layer (app/llm.py).
# The system works correctly with this left blank — the grounded,
# template-assembled answer is used as-is (llm_paraphrased=false in the
# API response). Setting these only adds a readability pass on top; it can
# never add uncited legal claims (see app/llm.py for the safety check).
GROQ_API_KEY=""
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Set to "false" to force-disable the paraphrase layer even if a key is set.
ENABLE_LLM_PARAPHRASE=true

# Optional bounded Groq research planner. Enable only if sending normalized
# user queries to Groq is acceptable for this deployment. The planner can
# propose at most three corpus searches within already-routed areas; it
# cannot add sources or write legal answers. Invalid/unavailable plans fall
# back to deterministic retrieval.
ENABLE_LLM_RESEARCH_PLANNER=false
 
# Use the built-in TF-IDF retriever. This avoids importing/downloading the
# optional fastembed/FAISS stack; sentence-transformers is not required.
SUTRADHARA_DISABLE_EMBEDDINGS=1

# Per-request timeout (seconds) for the Groq call before falling back.
GROQ_TIMEOUT_SECONDS=12

# --------------------------------------------------------------------------
# Bhashini (ULCA / MeitY Digital India language infrastructure)
# --------------------------------------------------------------------------
# The problem statement explicitly names Bhashini as the preferred
# multilingual provider. Free registration / key issuance:
# https://bhashini.gov.in (developer console).
# This deployment uses a single, unified Bhashini credential pair for all
# services: NMT (translation), ASR (speech-to-text), and TTS (text-to-speech).
# It is optional: leaving it blank does not break the app, it only disables
# Bhashini gracefully (translation falls back to Sarvam/Google/MyMemory;
# voice features fall back to Sarvam, or are disabled if Sarvam is also unset).

BHASHINI_USER_ID=""
BHASHINI_API_KEY=""

# Optional: override the default public pipeline id if your registered
# account uses a different one (check the Bhashini developer console).
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Sarvam speech-to-text, text-to-speech, and translation (FALLBACK ONLY) ---
# Only used when Bhashini is unconfigured or a call fails —
# Bhashini is primary for both translation and voice.
SARVAM_API_KEY=""
# --------------------------------------------------------------------------
# Corpus freshness thresholds (app/corpus_freshness.py)
# --------------------------------------------------------------------------
# Days since a corpus entry's retrieved_date before it's bucketed "aging"/
# "stale". Both optional — sensible defaults are built in.
# SUTRADHARA_FRESH_DAYS=90
# SUTRADHARA_STALE_DAYS=180

# --------------------------------------------------------------------------
# Optional live Neo4j knowledge-graph backend (app/graph_store.py)
# --------------------------------------------------------------------------
# All three must be set for the live backend to activate; otherwise
# app/graph_reasoning.py's in-memory traversal runs unchanged.
NEO4J_URI=""
NEO4J_USERNAME=""
NEO4J_PASSWORD=""


# Set to "1" to force the in-memory graph even if the above are configured.
# SUTRADHARA_DISABLE_NEO4J=1
# --------------------------------------------------------------------------
# Ministry / Admin RBAC invite code (app/admin_auth.py)
# --------------------------------------------------------------------------
# Code required to create an admin/ministry account. Defaults to "MINISTRY2026" if unset.
SUTRADHARA_ADMIN_CODE=""