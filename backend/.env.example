# Groq API configuration for the optional answer-paraphrase layer (app/llm.py).
# The system works correctly with this left blank — the grounded,
# template-assembled answer is used as-is (llm_paraphrased=false in the
# API response). Setting these only adds a readability pass on top; it can
# never add uncited legal claims (see app/llm.py for the safety check).
GROQ_API_KEY=""
GROQ_MODEL=openai/gpt-oss-120b

# Set to "false" to force-disable the paraphrase layer even if a key is set.
ENABLE_LLM_PARAPHRASE=true

# Per-request timeout (seconds) for the Groq call before falling back.
GROQ_TIMEOUT_SECONDS=12

# --------------------------------------------------------------------------
# Bhashini (ULCA / MeitY Digital India language infrastructure)
# --------------------------------------------------------------------------
# The problem statement explicitly names Bhashini as the preferred
# multilingual provider. Free registration / key issuance:
# https://bhashini.gov.in (developer console).
#
# This deployment uses TWO SEPARATE Bhashini credential pairs — one
# authorized for NMT (translation), one authorized for ASR (speech-to-text)
# — matching how Bhashini can issue distinct per-service keys. Each is
# independently optional: leaving either blank does not break the app, it
# only disables that one feature gracefully (translation falls back to
# Google Translate / MyMemory; the microphone button is greyed out in the UI
# and shows a tooltip explaining why — see app/translate.py and app/asr.py).

# --- NMT (translation) key pair ---
BHASHINI_NMT_USER_ID=""
BHASHINI_NMT_API_KEY=""
# Optional: override the default public MT pipeline id if your registered
# account uses a different one (check the Bhashini developer console).
# BHASHINI_NMT_PIPELINE_ID=64392f96daac500b55c543cd

# --- Sarvam speech-to-text and text-to-speech ---
SARVAM_API_KEY=""

# Backward-compatible fallback names (still read if the NMT-specific ones
# above are unset) — kept only so an older single-key setup doesn't break:
# BHASHINI_USER_ID="..."
# BHASHINI_API_KEY="..."